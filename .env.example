# Copy this file to .env and fill in real values. NEVER commit .env.
# Placeholders only below. Make a secret with:  openssl rand -hex 32

# ===== SERVER (Ubuntu, used by docker-compose.yml and Caddyfile) =====
# Database password. Do NOT change it on a running database (Postgres keeps the old one in its volume).
DB_PASSWORD=change-me-openssl-rand-hex-16

# Signs login tokens (12 h). At least 32 characters. Changing it logs everyone out.
JWT_SECRET=change-me-openssl-rand-hex-32

# Site address for HTTPS: a domain name or the server IP. Empty = plain HTTP on port 80 (testing only).
DOMAIN=

# Certificate type: classic (domain name) or shortlived (required when DOMAIN is an IP address).
ACME_PROFILE=classic

# On the server, do NOT set these: docker-compose.yml sets them for the app container.
#   PORT, DATABASE_URL, REDIS_URL, TRUST_PROXY

# ===== LAPTOP (npm start = node --env-file=.env server.js) =====
# Use these lines instead of the server block above.
# DATABASE_URL=postgres://livescore:<local-password>@localhost:5432/livescore
# REDIS_URL=redis://localhost:6379
# JWT_SECRET=<any long random string for local use>
# PORT=3000
# Do not set TRUST_PROXY on a laptop (only behind Caddy).

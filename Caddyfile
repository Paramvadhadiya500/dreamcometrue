{
	# Browsers send no server name when you open https://<IP address>, and on AWS the server only knows
	# its private IP, so Caddy could not pick the certificate. This tells it which one to use.
	default_sni {$DOMAIN}

	# Which certificate "profile" to ask Let's Encrypt for.
	#   classic     = normal 90-day certificate, for a domain name (default)
	#   shortlived  = 6-day certificate, REQUIRED when the site address is a bare IP address
	cert_issuer acme {
		profile {$ACME_PROFILE:classic}
	}
}

# DOMAIN is the address of the site: a domain name, an IP address, or ":80" for plain HTTP (testing only).
{$DOMAIN} {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=86400"
	}

	reverse_proxy app:3000

	# The app does not answer (502 bad gateway, 503, 504: a restart, a crash, a deploy): instead of an empty error,
	# show a small friendly page. It is a file Caddy serves by itself (public-errors/down.html, mounted read-only
	# in docker-compose.yml), refreshes itself every 20 s, and must never be kept in a cache.
	handle_errors {
		@down expression `{err.status_code} >= 502 && {err.status_code} <= 504`
		handle @down {
			root * /srv/errors
			rewrite * /down.html
			header Cache-Control "no-store"
			file_server
		}
	}
}
